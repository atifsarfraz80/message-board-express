<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Message Board</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('navbar') %>
    <main class="page-container hero-section">
      <h1 class="page-title"><%= title %></h1>
      <p class="hero-description">
        Welcome! Read recent posts or add your own voice to the board.
      </p>
      <div class="hero-actions">
        <a href="/messages" class="btn btn-secondary">View Messages</a>
        <a href="/new" class="btn btn-primary">Compose Message</a>
      </div>
    </main>
  </body>
</html>
