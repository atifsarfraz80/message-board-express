<form method="POST" action="/new">
  <%- include('navbar') %>
  <h1>Compose a new message!</h1>
  <label for="name">Name:</label>
  <input
    type="text"
    name="name"
    id="name"
    placeholder="lappu sa sachin"
    required
  />
  <label for="message">Message:</label>
  <textarea name="newmessage" id="message" rows="10" cols="20"></textarea>
  <button type="submit">Submit</button>
</form>
