<li class="message-card">
  <div class="message-header">
    <span class="message-author"><%= message.user %></span>
    <time class="message-timestamp">
      <%= new Date(message.added).toLocaleDateString("en-US", { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" }) %>
    </time>
  </div>
  <p class="message-body"><%= message.text %></p>
</li>