<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Message Details</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('../navbar') %>
    <main class="page-container">
      <div class="message-card detail-card">
        <div class="message-header">
          <h2 class="message-author"><%= message.user %></h2>
          <time class="message-timestamp">
            <%= new Date(message.added).toLocaleString("en-US") %>
          </time>
        </div>
        <p class="message-body-large"><%= message.text %></p>
        <div class="detail-actions">
          <a href="/messages" class="btn btn-secondary"
            >← Back to All Messages</a
          >
        </div>
      </div>
    </main>
  </body>
</html>
